{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hive",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "HIVE_MODEL": "claude-opus-5-5",
    "HIVE_EFFORT": "low",
    // Agent runs per user per day. Logins in HIVE_ADMINS are exempt.
    "HIVE_DAILY_AGENT_LIMIT": "20",
    "HIVE_ADMINS": "dunkbing",
  },
  // Secrets: ANTHROPIC_API_KEY, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (see .dev.vars.example).
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "hive", "remote": true }],
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "REPO", "class_name": "RepoCoordinator" },
      { "name": "AGENT", "class_name": "HiveAgent" },
      { "name": "SANDBOX", "class_name": "HiveSandbox" },
    ],
  },
  // Each check runs in a fresh Linux sandbox (a container started from a Durable Object).
  "containers": [{ "class_name": "HiveSandbox", "scheduling_policy": "durable_object" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoCoordinator", "HiveAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "new_sqlite_classes": ["HiveSandbox"] },
  ],
}
